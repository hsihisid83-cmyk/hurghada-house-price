import streamlit as st

st.set_page_config(page_title="بنك أسئلة الفلسفة", page_icon="🧠", layout="centered")
st.title("🧠 بنك أسئلة الفلسفة والمنطق")
st.subheader("من ملف حل المفكر - الأسبوع السابع - الصف الأول الثانوي")
st.divider()

questions = [
    {
        "type": "كتاب المدرسة",
        "q": "يقول كونفوشيوس: 'لا تفعل بالآخرين ما لا تريد أن يُفعل بك' يؤكد الطابع؟",
        "options": ["النظري الخالص", "العقلي المجرد", "العملي التطبيقي", "المعنوي الخالص"],
        "correct": "العملي التطبيقي"
    },
    {
        "type": "الواجب المنزلي",
        "q": "الفلسفة اليوم صارت بوصلة الإنسان وغايتها إيقاظ الوعي. يدل على أهمية الفلسفة في الجانب؟",
        "options": ["الاجتماعي", "المعرفي", "الروحي", "السياسي"],
        "correct": "الروحي / المعرفي (إيقاظ الوعي)"
    },
    {
        "type": "منطق - الواجب",
        "q": "'السعادة تنبع من النفس' .. كلمة 'تنبع' تدل على؟",
        "options": ["المخبر عنه", "الرابطة السالبة", "الرابطة الموجبة", "المخبر به"],
        "correct": "المخبر به"
    },
    {
        "type": "منطق - الواجب",
        "q": "'كل الوزارات الحكومية مقرها العاصمة الإدارية الجديدة' .. هذه القضية تعتبر؟",
        "options": ["تحليلية", "تركيبية", "بسيطة سالبة", "مركبة"],
        "correct": "تركيبية (تحتاج للواقع للتأكد)"
    },
    {
        "type": "التقييم الأسبوعي",
        "q": "الفكر اليوناني القديم لم يكتف بوصف الكون، بل سأل وأجاب بالعقل والبرهان والجدل، لا بالوحي أو الأسطورة. يدل على الطابع؟",
        "options": ["الديني الإيماني", "التطبيقي النفعي", "العقلي الخالص", "العملي التطبيقي"],
        "correct": "العقلي الخالص"
    },
    {
        "type": "التقييم الأسبوعي",
        "q": "'كل عدد زوجي يقبل القسمة على 2' .. صدق هذه القضية يتوقف على؟",
        "options": ["مطابقتها للواقع", "اتساق طرفيها", "تناقض طرفيها", "مخالفتها للواقع"],
        "correct": "اتساق طرفيها"
    },
    {
        "type": "التقييم الأسبوعي",
        "q": "'الفلسفة وجهة نظر عقلية فردية شاملة للوجود والحياة والقيم' .. هذا تعريف؟",
        "options": ["الشخصي", "العام", "المطلق", "الجماعي"],
        "correct": "الشخصي"
    },
    {
        "type": "التقييم الأسبوعي",
        "q": "يقول أرسطو: 'لذة الفكر في التأمل' .. يدل على سعي الفكر الفلسفي اليوناني إلى؟",
        "options": ["المطالب العملية", "اللذة الحسية", "المنفعة العملية", "المتعة العقلية"],
        "correct": "المتعة العقلية"
    },
]

score = 0
for i, item in enumerate(questions):
    st.markdown(f"**{i+1}- [{item['type']}]** {item['q']}")
    ans = st.radio("اختار الإجابة:", item['options'], key=f"q{i}", index=None)
    if ans:
        if ans == item['correct'] or item['correct'] in ans:
            st.success("✅ صح")
            score += 1
        else:
            st.error(f"❌ الصح: {item['correct']}")
    st.write("")

st.divider()
if st.button("احسب نتيجتك النهائية"):
    st.balloons()
    st.metric("نتيجتك", f"{score} / {len(questions)}")
